# Admin dashboard — copy to apps/admin/.env.local (or set in Vercel for newyouai-admin only).
# Staff ops console at https://admin.newyouai.app — separate from app.newyouai.app.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Canonical admin origin. Do not point at the consumer app.
NEXT_PUBLIC_ADMIN_SITE_URL=https://admin.newyouai.app

# Server-only — never prefix with NEXT_PUBLIC_. Required for reading user data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated staff emails allowed to sign in (required in production).
# Each email must have a password set in Supabase Auth (Dashboard → Authentication → Users).
ADMIN_ALLOWED_EMAILS=jimmy.mccarthy@newyouai.app

# Where user impersonation links redirect — the consumer app, not admin.
NEXT_PUBLIC_PWA_URL=https://app.newyouai.app
