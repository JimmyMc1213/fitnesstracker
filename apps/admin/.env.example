# Admin dashboard — copy to apps/admin/.env.local (or set in monorepo root .env).
# URL + anon key are also read from VITE_SUPABASE_* in the repo root .env.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only — never prefix with NEXT_PUBLIC_. Required for reading user data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated staff emails allowed to sign in.
ADMIN_ALLOWED_EMAILS=you@newyouai.app

# Where impersonation magic links redirect (optional).
NEXT_PUBLIC_PWA_URL=https://app.newyouai.app
