{
  "name": "@newyouai/mobile",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "web": "expo start --web",
    "dev:visual-parity": "EXPO_PUBLIC_VISUAL_PARITY=true EXPO_PUBLIC_E2E_FITNESS_SEED=coach-nutrition EXPO_PUBLIC_MAESTRO_SKIP_ONBOARDING=true expo start --web --port 8086",
    "dev:preview-onboarding": "EXPO_PUBLIC_PREVIEW_ONBOARDING=1 expo start --web --port 8085",
    "eas": "eas",
    "typecheck": "tsc --noEmit",
    "build": "echo mobile-build-stub",
    "test": "vitest run",
    "test:e2e": "maestro test .maestro/smoke.yaml",
    "test:e2e:auth": "maestro test .maestro/rn-auth-gate.yaml",
    "test:e2e:auth-sign-in": "maestro test .maestro/rn-auth-gate-sign-in.yaml",
    "test:e2e:auth-sign-up": "maestro test .maestro/rn-auth-sign-up.yaml",
    "test:e2e:auth-sign-out": "node scripts/run-auth-sign-out-maestro.mjs",
    "test:e2e:settings": "node scripts/run-settings-maestro.mjs",
    "test:e2e:auth-all": "node scripts/run-auth-maestro.mjs",
    "test:e2e:tab-nav": "node scripts/run-tab-nav-maestro.mjs",
    "test:e2e:onboarding": "node scripts/run-onboarding-maestro.mjs",
    "test:e2e:coach-nutrition": "node scripts/run-coach-nutrition-maestro.mjs",
    "test:e2e:workout-session": "node scripts/run-workout-session-maestro.mjs",
    "test:e2e:nutrition-log": "node scripts/run-nutrition-log-maestro.mjs",
    "test:e2e:progress": "node scripts/run-progress-maestro.mjs",
    "test:e2e:sunday-check-in": "node scripts/run-sunday-check-in-maestro.mjs",
    "test:e2e:future-you": "node scripts/run-future-you-maestro.mjs",
    "test:e2e:sync": "node scripts/run-sync-maestro.mjs",
    "test:e2e:epic-rn-offline-close": "node scripts/run-epic-rn-offline-close.mjs",
    "test:e2e:epic-rn6-close": "node scripts/run-epic-rn6-close.mjs",
    "test:e2e:epic-rn7-close": "node scripts/run-epic-rn7-close.mjs",
    "test:e2e:epic-rn8-close": "node scripts/run-epic-rn8-close.mjs",
    "test:e2e:epic-rn9-close": "node scripts/run-epic-rn9-close.mjs",
    "test:e2e:epic-rn10-close": "node scripts/run-epic-rn10-close.mjs",
    "lint": "echo lint-stub"
  },
  "dependencies": {
    "@newyouai/api-client": "^0.0.0",
    "@newyouai/config": "*",
    "@newyouai/core": "*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.108.1",
    "expo": "~56.0.11",
    "expo-apple-authentication": "~56.0.0",
    "expo-auth-session": "~56.0.0",
    "expo-camera": "~56.0.5",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.20",
    "expo-font": "~56.0.6",
    "expo-image-manipulator": "~56.0.18",
    "expo-image-picker": "~56.0.17",
    "expo-linking": "~56.0.13",
    "expo-notifications": "~56.0.0",
    "expo-router": "~56.2.10",
    "expo-secure-store": "^56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-web-browser": "~56.0.5",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-css-interop": "^0.2.5",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "^3.0.1",
    "react-native-purchases": "^10.3.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~56.0.0",
    "eas-cli": "^20.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
