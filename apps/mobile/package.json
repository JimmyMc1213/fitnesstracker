{
  "name": "@newyouai/mobile",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "web": "expo start --web",
    "eas": "eas",
    "typecheck": "tsc --noEmit",
    "build": "echo mobile-build-stub",
    "test": "echo no-tests",
    "test:e2e": "maestro test .maestro/smoke.yaml",
    "test:e2e:auth": "maestro test .maestro/rn-auth-gate.yaml",
    "test:e2e:auth-sign-in": "maestro test .maestro/rn-auth-gate-sign-in.yaml",
    "test:e2e:auth-sign-up": "maestro test .maestro/rn-auth-sign-up.yaml",
    "test:e2e:auth-sign-out": "maestro test .maestro/rn-auth-sign-out.yaml",
    "test:e2e:auth-all": "node scripts/run-auth-maestro.mjs",
    "lint": "echo lint-stub"
  },
  "dependencies": {
    "@newyouai/api-client": "^0.0.0",
    "@newyouai/config": "*",
    "@newyouai/core": "*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.108.1",
    "expo": "~56.0.9",
    "expo-apple-authentication": "~56.0.0",
    "expo-auth-session": "~56.0.0",
    "expo-constants": "~56.0.17",
    "expo-dev-client": "~56.0.20",
    "expo-font": "~56.0.5",
    "expo-linking": "~56.0.13",
    "expo-router": "~56.2.9",
    "expo-secure-store": "^56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-web-browser": "~56.0.5",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-css-interop": "^0.2.5",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~56.0.0",
    "eas-cli": "^20.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  }
