# Supabase, same project as PWA (root .env uses VITE_* prefix).
# Expo only reads EXPO_PUBLIC_* from this file (apps/mobile/.env).
#
# Key (pick ONE, both names work):
#   • Recommended: Publishable key → EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   • Legacy: JWT anon / public role (eyJ…) → EXPO_PUBLIC_SUPABASE_ANON_KEY
# Never put service_role or other server secrets here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional legacy anon JWT (if not using publishable key):
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt

# Show onboarding wizard after sign-in (dev). Restart Metro after changing.
EXPO_PUBLIC_MAESTRO_SKIP_ONBOARDING=false

# Simulator onboarding (npm run dev:onboarding sets these automatically):
# EXPO_PUBLIC_E2E_MOCK_FUTURE_YOU=true   — tap Take a photo without camera
# EXPO_PUBLIC_ONBOARDING_DEV_TOOLS=1     — Start fresh (dev) on Welcome screen

# Dev/E2E only: seed fitness slice on launch (overwrites local fitness storage). Requires __DEV__.
# Use with Maestro flows, start Metro with the same value:
#   EXPO_PUBLIC_E2E_FITNESS_SEED=coach-nutrition npm run dev
#   EXPO_PUBLIC_E2E_FITNESS_SEED=workout-session npm run dev
#   EXPO_PUBLIC_E2E_FITNESS_SEED=nutrition-log EXPO_PUBLIC_E2E_MOCK_FOOD_SEARCH=true npm run dev
#   EXPO_PUBLIC_E2E_FITNESS_SEED=progress npm run dev
#   EXPO_PUBLIC_E2E_FITNESS_SEED=future-you EXPO_PUBLIC_E2E_MOCK_FUTURE_YOU=true npm run dev
# EXPO_PUBLIC_E2E_FITNESS_SEED=coach-nutrition
# EXPO_PUBLIC_E2E_FITNESS_SEED=workout-session
# EXPO_PUBLIC_E2E_FITNESS_SEED=nutrition-log
# EXPO_PUBLIC_E2E_FITNESS_SEED=progress
# EXPO_PUBLIC_E2E_FITNESS_SEED=future-you
# EXPO_PUBLIC_E2E_MOCK_FOOD_SEARCH=true
# EXPO_PUBLIC_E2E_MOCK_FUTURE_YOU=true

# Dev/E2E only: show Sunday check-in card and flow on any day (mirrors PWA ?previewSunday=1).
# EXPO_PUBLIC_E2E_DEV_PREVIEW_SUNDAY=true

# RevenueCat sandbox (RN-4-10 paywall). Required for launch — omit only for local stub/Maestro.
# Setup: docs/revenuecat-app-store-setup.md
# Product IDs in App Store Connect: newyouai_pro_monthly ($14.99), newyouai_pro_yearly ($69.99)
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxx
