# Supabase — same project as PWA (root .env uses VITE_* prefix).
# Expo only reads EXPO_PUBLIC_* from this file (apps/mobile/.env).
#
# Key (pick ONE, both names work):
#   • Recommended: Publishable key → EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   • Legacy: JWT anon / public role (eyJ…) → EXPO_PUBLIC_SUPABASE_ANON_KEY
# Never put service_role or other server secrets here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional legacy anon JWT (if not using publishable key):
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt
