# Supabase → Project Settings → API
#
# URL: Project URL (https://….supabase.co)
#
# Key (pick ONE, both names work):
#   • Recommended (new UI): Publishable key → VITE_SUPABASE_PUBLISHABLE_KEY
#   • Legacy: JWT “anon” / public role (long eyJ… string) → VITE_SUPABASE_ANON_KEY
# Never put the secret / service_role JWT in this file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side only — never use VITE_* for these (they would ship to the browser).
# Set in Supabase Edge Function secrets for deployed functions:
#   supabase secrets set OPENAI_API_KEY=your-openai-api-key
# Optional:
#   USDA_FDC_API_KEY                # FoodData Central — https://fdc.nal.usda.gov/api-key-signup.html

# Comma-separated emails that skip new-user onboarding (personal / legacy accounts).
# Dev accounts should NOT be listed here — sign in with a separate email for testing onboarding.
# VITE_LEGACY_USER_EMAILS=you@personal.example.com

# Local dev fallback when VITE_LEGACY_USER_EMAILS is unset (never commit a real address).
# VITE_DEV_SKIP_EMAIL=you@personal.example.com

# Optional local dev auto sign-in (never commit real passwords). Session is also restored from Supabase on refresh.
# VITE_DEV_AUTO_SIGN_IN_EMAIL=you@nodoublesgolfco.com
# VITE_DEV_AUTO_SIGN_IN_PASSWORD=your-dev-password
